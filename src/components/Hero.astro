---
const heroTitle = "بشرتك، بصمتك الجميلة";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">عناية فاخرة بالبشرة</p>
      <h1 id="hero-title">{heroTitle}</h1>
      <p class="description">
        اكتشفي أساسيات العناية المناسبة لبشرتك،
        <br />
        واستمتعي بروتين بسيط يمنح كل يوم لمسة مميزة.
      </p>
    </div>
    <div class="hero-product" data-parallax>
      <img
        src="/images/hero-cream.png"
        alt="كريم إيفولف العضوي لتجديد بشرة الوجه"
        width="1254"
        height="1254"
        fetchpriority="high"
      />
    </div>
    <div class="hero-wordmark" aria-hidden="true" dir="ltr">
      SKINLUXE
    </div>
  </div>
</section>
