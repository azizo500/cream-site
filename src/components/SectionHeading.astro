---
interface Props {
  label: string;
  title: string;
  description?: string;
  align?: "center" | "start";
}
const { label, title, description, align = "center" } = Astro.props;
---

<div
  class:list={[
    "section-heading",
    { "section-heading--start": align === "start" },
  ]}
  data-reveal
>
  <p class="eyebrow">{label}</p>
  <h2>{title}</h2>
  {description && <p class="description">{description}</p>}
</div>
